{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcshift:observation:candidate:1",
  "title": "Candidate normalized raw observation; not a permission or freshness verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "series_id", "definition_version", "resource_id", "units", "value", "quality", "reference_start", "reference_end", "effective_date", "published_at", "publication_status", "received_at", "source_timezone", "snapshot_id", "receipt_sha256", "dimensions", "is_synthetic"],
  "properties": {
    "schema_version": {"const": "candidate.1"},
    "series_id": {"type": "string", "minLength": 1},
    "definition_version": {"const": "candidate.1"},
    "resource_id": {"type": "string", "minLength": 1},
    "units": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "null"]},
    "quality": {"enum": ["observed", "missing", "rejected"]},
    "reference_start": {"type": "string", "format": "date"},
    "reference_end": {"type": "string", "format": "date"},
    "effective_date": {"type": ["string", "null"], "format": "date"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "publication_status": {"enum": ["known", "unknown"]},
    "received_at": {"type": "string", "format": "date-time"},
    "source_timezone": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "receipt_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "dimensions": {"type": "object"},
    "is_synthetic": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"quality": {"const": "observed"}}}, "then": {"properties": {"value": {"type": "number"}}}, "else": {"properties": {"value": {"type": "null"}}}},
    {"if": {"properties": {"publication_status": {"const": "known"}}}, "then": {"properties": {"published_at": {"type": "string"}}}, "else": {"properties": {"published_at": {"type": "null"}}}}
  ]
}
